  "config": {
    "appName": "playwebsite"
  },
  "author": {
    "name": "Sitecore Demo Solutions Team",
    "url": "https://www.sitecore.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit.git"
  },
  "bugs": {
    "url": "https://github.com/Sitecore/Sitecore.Demo.XmCloud.PlaySummit/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-regular-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.5.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "@sitecore-feaas/clientside": "^0.6.0",
    "@sitecore-search/react": "^3.0.0",
    "@sitecore/components": "~2.1.0",
    "html-react-parser": "^5.1.1",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "next": "^16.2.0",
    "next-intl": "^4.3.5",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-sassy-mixins": "^2.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-loading-skeleton": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@sitecore-content-sdk/cli": "^2.4.0",
    "@sitecore-search/cli": "^3.0.0",
    "@storybook/nextjs": "^10.6.6",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.14.178",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.2",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.4.23",
    "prettier": "^2.8.3",
    "storybook": "^10.6.6",
    "stylelint": "^13.13.1",
    "stylelint-config-standard": "^22.0.0",
    "tailwindcss": "^3.0.23",
    "typescript": "~5.8.3",
    "webpack": "^5.112.2"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "build:local": "npm-run-all build",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial build next:start",
    "start:connected": "npm-run-all dev",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "eslint": "eslint ./src",
    "stylelint": "stylelint \"./src/**/*.css\"",
    "lint": "npm-run-all --serial eslint stylelint",
    "type-check": "tsc --noEmit",
    "storybook": "npm-run-all --serial sitecore-tools:generate-map storybook:start",
    "storybook:start": "storybook dev -p 6006",
    "build-storybook": "npm-run-all --serial sitecore-tools:generate-map storybook:build",
    "storybook:build": "storybook build"
  },
  "engines": {
    "node": ">=24"
  }
}
