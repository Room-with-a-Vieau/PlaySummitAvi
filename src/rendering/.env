# Copy values to .env.local, which git ignores, to connect to a Sitecore environment.
# See https://doc.sitecore.com/sai/en/developers/content-sdk/sitecore-content-sdk-for-sitecoreai.html

# Secures the Sitecore editor endpoints (/api/editing/*). Use at least 16 alphanumeric characters.
SITECORE_EDITING_SECRET=

# ====== SitecoreAI ======
# Server-side Edge Context ID. Takes priority over the local container settings below.
SITECORE_EDGE_CONTEXT_ID=

# Browser-side Edge Context ID, used for events and BYOC components.
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=

# Optional custom Edge Platform host.
NEXT_PUBLIC_SITECORE_EDGE_PLATFORM_HOSTNAME=

# ====== Local containers ======
SITECORE_API_HOST=
SITECORE_API_KEY=1047aee5-9bcd-4dbf-9744-a26e12b79ab6

# ====== Site ======
# Defaults to playwebsite.
NEXT_PUBLIC_DEFAULT_SITE_NAME=

# Defaults to en.
NEXT_PUBLIC_DEFAULT_LANGUAGE=

# Absolute URL of this website. Empty uses the browser origin and relative asset paths.
NEXT_PUBLIC_PUBLIC_URL=

# Set to false to skip prerendering Sitecore pages at build time.
GENERATE_STATIC_PATHS=

# ====== Personalization ======
# Isolates personalization data when environments share a tenant.
# Must match PAGES_PERSONALIZE_SCOPE on the connected environment.
NEXT_PUBLIC_PERSONALIZE_SCOPE=

# Timeouts in ms. Both default to 400.
PERSONALIZE_MIDDLEWARE_CDP_TIMEOUT=
PERSONALIZE_MIDDLEWARE_EDGE_TIMEOUT=

# Enables Content SDK debug logs, for example content-sdk:*
#DEBUG=content-sdk:*

# ====== Search API ======
NEXT_PUBLIC_SEARCH_API_DOMAIN=
NEXT_PUBLIC_SEARCH_API_HOST=

# ====== Search SDK ======
NEXT_PUBLIC_SEARCH_ENV=
NEXT_PUBLIC_SEARCH_CUSTOMER_KEY=
NEXT_PUBLIC_SEARCH_API_KEY=
